{
  "name": "techno-play",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generation/verifier-contenu.js && node scripts/generation/verifier-lisibilite.js",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "new-post": "node scripts/new-post.js",
    "generate-covers": "node scripts/generate-covers.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "test:garde-fou": "node --test \"scripts/generation/*.test.js\"",
    "lisibilite": "node scripts/generation/verifier-lisibilite.js",
    "garde-fou:cutoff": "node scripts/generation/llm.js --cutoff",
    "garde-fou:audit": "node scripts/generation/llm.js --audit",
    "auteur": "node scripts/generation/choisir-auteur.js"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.34.5"
  }
}
