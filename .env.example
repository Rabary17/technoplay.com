# Variables de la fonction api/lead.js (à définir dans les réglages du projet Vercel,
# jamais dans le dépôt). Le domaine dépend du centre de données du compte Zoho :
# .com (US), .eu (EU), .in (Inde), .com.au (Australie)...
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Origines autorisées à envoyer le formulaire (séparées par des virgules).
ALLOWED_ORIGINS=https://techno-play.com,https://www.techno-play.com

# Côté site (optionnel) : laisser vide si la fonction est sur le même domaine.
# NEXT_PUBLIC_LEAD_ENDPOINT=https://ton-projet.vercel.app/api/lead
